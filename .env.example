DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_HUMAN_MODEL=deepseek-v4-flash
DEEPSEEK_AGENT_MODEL=deepseek-v4-pro
# Optional: enabled | disabled. Leave blank to avoid constraining DeepSeek defaults.
DEEPSEEK_HUMAN_THINKING=
DEEPSEEK_AGENT_THINKING=enabled
DEEPSEEK_AGENT_REASONING_EFFORT=high
AGENT_IM_MEDIA_DIR=data/media
